# Pinata JWT — create one at https://app.pinata.cloud/developers/api-keys
# (needs "Files: Write" permission at minimum)
PINATA_JWT=

# Optional overrides
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Signs session tokens for wallet sign-in. Optional in dev — if unset, a
# random secret is generated and persisted to server/data/session-secret.txt
# on first run. Set this explicitly in production (a stable value there
# means a server restart doesn't invalidate every session).
SESSION_SECRET=
