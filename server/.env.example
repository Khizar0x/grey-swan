# Pinata JWT — create one at https://app.pinata.cloud/developers/api-keys
# (needs "Files: Write" permission at minimum)
PINATA_JWT=

# Optional overrides
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Signs session tokens for wallet sign-in. Optional in dev — if unset, a
# random secret is generated and persisted to server/data/session-secret.txt
# on first run. Set this explicitly in production (a stable value there
# means a server restart doesn't invalidate every session).
SESSION_SECRET=

# Devnet RPC used to read the Config PDA's admin pubkey for the admin page's
# access control (config.ts). Falls back to the public devnet endpoint if
# unset — fine for this one infrequent, cached read, unlike the frontend's
# much heavier RPC usage.
RPC_URL=

# AI verdict pipeline (server/src/ai). Mock by default; live spends real credit.
ANTHROPIC_API_KEY=
AI_MODE=mock
AI_MODEL_A=claude-haiku-5-5
AI_MODEL_B=claude-sonnet-5-5
AI_DAILY_LIVE_CAP=40
# Stand-in for Config.large_deposit_threshold_lamports (default 5 SOL). In
# production, read this from the on-chain Config account instead.
AI_LARGE_DEPOSIT_THRESHOLD_LAMPORTS=5000000000
