# Dedicated devnet RPC (Helius, QuickNode, etc.) — the public
# api.devnet.solana.com endpoint rate-limits under normal app usage.
# Falls back to the public endpoint if left unset.
VITE_RPC_URL=

# Mapbox access token (public/client-side token — see
# https://docs.mapbox.com/help/getting-started/access-tokens/). Used to
# validate delivery addresses and estimate pickup distance.
VITE_MAPBOX_TOKEN=
